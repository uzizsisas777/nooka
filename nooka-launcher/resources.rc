NOOKA_ICON ICON "icon.ico"

// Identidad del PE: sin VERSIONINFO el archivo no dice quien lo hizo ni que version es, y
// un exe sin datos de version que ademas baja y descomprime otros exes es el perfil que
// levantan los antivirus. Los valores van a mano porque el launcher y el updater descubren
// su version escaneando app-*/, no leyendo su propio recurso.
// OJO: nada de acentos aqui - windres interpreta el .rc en la pagina de codigos del sistema.
1 VERSIONINFO
 FILEVERSION 1,0,5,0
 PRODUCTVERSION 1,0,5,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nooka"
            VALUE "FileDescription", "Nooka launcher"
            VALUE "FileVersion", "1.0.5.0"
            VALUE "InternalName", "Nooka"
            VALUE "LegalCopyright", "Nooka"
            VALUE "OriginalFilename", "Nooka.exe"
            VALUE "ProductName", "Nooka"
            VALUE "ProductVersion", "1.0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// RT_MANIFEST (24) con asInvoker explicito.
1 24 "app.manifest"
