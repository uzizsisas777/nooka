NOOKA_ICON ICON "icon.ico"

// Identidad del PE: este es el archivo que se descarga de GitHub y el que un antivirus
// mira primero. Sin VERSIONINFO no dice quien lo hizo ni que version es, y un exe sin
// datos de version que ademas descomprime otros exes en AppData es el perfil que levantan.
// OJO: nada de acentos aqui - windres interpreta el .rc en la pagina de codigos del sistema.
1 VERSIONINFO
 FILEVERSION 1,0,5,0
 PRODUCTVERSION 1,0,5,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nooka"
            VALUE "FileDescription", "Nooka Setup"
            VALUE "FileVersion", "1.0.5.0"
            VALUE "InternalName", "NookaSetup"
            VALUE "LegalCopyright", "Nooka"
            VALUE "OriginalFilename", "NookaSetup.exe"
            VALUE "ProductName", "Nooka"
            VALUE "ProductVersion", "1.0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// RT_MANIFEST (24) con asInvoker explicito: sin manifiesto, Windows aplica su heuristica
// de "installer detection" sobre los nombres *Setup.exe y puede sacar un UAC para algo que
// solo escribe en %LocalAppData%.
1 24 "app.manifest"
