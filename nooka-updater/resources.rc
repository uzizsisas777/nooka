IDI_ICON1 ICON "icon.ico"

// Identidad del PE: sin VERSIONINFO el archivo no dice quien lo hizo ni que version es, y
// un exe sin datos de version que ademas baja y descomprime otros exes es el perfil que
// levantan los antivirus. OJO: nada de acentos aqui - windres interpreta el .rc en la
// pagina de codigos del sistema.
1 VERSIONINFO
 FILEVERSION 1,0,5,0
 PRODUCTVERSION 1,0,5,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nooka"
            VALUE "FileDescription", "Nooka updater"
            VALUE "FileVersion", "1.0.5.0"
            VALUE "InternalName", "Update"
            VALUE "LegalCopyright", "Nooka"
            VALUE "OriginalFilename", "Update.exe"
            VALUE "ProductName", "Nooka"
            VALUE "ProductVersion", "1.0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// RT_MANIFEST (24) con asInvoker explicito.
1 24 "app.manifest"
